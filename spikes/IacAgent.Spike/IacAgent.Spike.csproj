<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
    <PackageReference Include="OllamaSharp" Version="5.5.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="fixtures\**\*.tf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="samples\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
