    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>IacAgent.Host.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\IacAgent.Cli\IacAgent.Cli.csproj" />
    <ProjectReference Include="..\..\src\IacAgent.Host\IacAgent.Host.csproj" />
    <None Include="..\fixtures\insecure\**\*" CopyToOutputDirectory="PreserveNewest" Link="fixtures\insecure\%(Filename)%(Extension)" />
    <ProjectReference Include="..\..\src\IacAgent.Plugins.Terraform\IacAgent.Plugins.Terraform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
