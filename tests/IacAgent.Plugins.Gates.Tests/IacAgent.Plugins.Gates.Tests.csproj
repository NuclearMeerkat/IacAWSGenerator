<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>IacAgent.Plugins.Gates.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\IacAgent.Plugins.Gates\IacAgent.Plugins.Gates.csproj" />
    <ProjectReference Include="..\..\src\IacAgent.Plugins.Terraform\IacAgent.Plugins.Terraform.csproj" />
    <None Include="..\fixtures\valid\**\*" CopyToOutputDirectory="PreserveNewest" Link="fixtures\valid\%(Filename)%(Extension)" />
    <None Include="..\fixtures\invalid-syntax\**\*" CopyToOutputDirectory="PreserveNewest" Link="fixtures\invalid-syntax\%(Filename)%(Extension)" />
    <None Include="..\fixtures\insecure\main.tf" CopyToOutputDirectory="PreserveNewest" Link="fixtures\insecure\main.tf" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Samples\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
